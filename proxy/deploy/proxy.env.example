# Copy to /etc/magic-meeting/proxy.env (chmod 600). Never commit the real file.
GROQ_API_KEY=gsk_replace_me
LISTEN_ADDR=127.0.0.1:8080
GROQ_STT_MODEL=whisper-large-v3
# LLM for summary, protocol and edits is an open question (TZ §10); pick on the pilot.
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Comma-separated bearer tokens for pilot builds, until App Attest is in place.
# Required: the proxy refuses to start when empty (unless ALLOW_NO_AUTH=1).
# Generate with: openssl rand -hex 24  (32+ characters; the placeholder below is rejected)
CLIENT_TOKENS=replace_me_with_a_long_random_token
# Local development only: allow requests without a token. Never set in production.
# ALLOW_NO_AUTH=1
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=25
UPSTREAM_TIMEOUT_SEC=180
