# Copy to /etc/magic-meeting/proxy.env (chmod 600). Never commit the real file.
GROQ_API_KEY=gsk_replace_me
LISTEN_ADDR=127.0.0.1:8080
GROQ_STT_MODEL=whisper-large-v3
# LLM for summary, protocol and edits is an open question (TZ §10); pick on the pilot.
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Comma-separated bearer tokens for pilot builds, until App Attest is in place.
CLIENT_TOKENS=
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=25
UPSTREAM_TIMEOUT_SEC=180
