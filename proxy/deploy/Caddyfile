# /etc/caddy/Caddyfile — TLS via Let's Encrypt, reverse proxy to the local service.
# Access logs stay off: request bodies are never logged anyway, but URLs and
# client IPs are not needed either.
proxy.example.com {
	request_body {
		max_size 30MB
	}
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			read_timeout 4m
			write_timeout 4m
		}
	}
}
