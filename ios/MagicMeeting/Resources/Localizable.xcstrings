      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт запись…"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        }
