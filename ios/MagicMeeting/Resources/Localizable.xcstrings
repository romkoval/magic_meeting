    "Copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копировать"
          }
        }
      }
    },
    "Could not prepare the audio for sending.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить аудио к отправке."
          }
        }
      }
    },
    "Could not start recording.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать запись."
