      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать согласие"
          }
        }
      }
    },
    "Without consent you can still record, and nothing leaves your iPhone, but recordings will not be transcribed. You can change this in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без согласия запись работает и ничего не покидает ваш iPhone, но записи не будут распознаваться. Это можно изменить в Настройках."
          }
        }
      }
    },
