{
  "sourceLanguage": "en",
  "strings": {
    "Allow microphone access in Settings to record meetings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к микрофону в Настройках, чтобы записывать встречи."
          }
        }
      }
    },
    "Allow sending audio to the AI service to get a transcript.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите отправку аудио в AI-сервис, чтобы получить транскрибацию."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешена"
          }
        }
      }
    },
    "Append": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозаписать"
          }
        }
      }
    },
    "Append to recording": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозапись"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически"
          }
        }
      }
    },
    "Automatic detection works for most meetings. Pick a language if short recordings are recognized in the wrong one.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоопределение подходит для большинства встреч. Выберите язык, если короткие записи распознаются не на том языке."
          }
        }
      }
    },
    "Before you record": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед записью"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
